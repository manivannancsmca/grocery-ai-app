<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>com.grocery</groupId>
    <artifactId>cart-service</artifactId>
    <version>0.12.0-SNAPSHOT</version>
    <name>cart-service</name>
    <description>One cart per customer in Redis (single store per cart), live cart pricing and the checkout preview (delivery fee, coupon, totals, blocking issues); empties the cart an order was placed from (order.events)</description>

    <properties>
        <java.version>25</java.version>
        <grocery-common.version>0.10.1</grocery-common.version>
        <grocery-event-schemas.version>1.7.0</grocery-event-schemas.version>
        <spring-cloud.version>2025.1.4</spring-cloud.version>
    </properties>

    <!-- grocery-common's Avro deserializer and Schema Registry client come from Confluent's repository (ADR-0011);
         Maven Central stays the default for everything else. -->
    <repositories>
        <repository>
            <id>confluent</id>
            <url>https://packages.confluent.io/maven/</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>com.grocery</groupId>
            <artifactId>grocery-common</artifactId>
            <version>${grocery-common.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-oauth2-resource-server</artifactId>
        </dependency>
        <!-- The cart store (the only store of this service: no MySQL, no outbox) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- Synchronous calls to pricing, inventory, catalog-query, vendor, restaurant and customer -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-restclient</artifactId>
        </dependency>
        <!-- One circuit breaker per dependency -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-circuitbreaker-resilience4j</artifactId>
        </dependency>
        <!-- order.events → OrderCreated empties the cart (consumer only: this service publishes nothing) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-kafka</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-oauth2-resource-server-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Event consumer contract tests (Phase 13 §4): samples generated from the schemas, shared helper -->
        <dependency>
            <groupId>com.grocery</groupId>
            <artifactId>grocery-event-schemas</artifactId>
            <version>${grocery-event-schemas.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Test only: the real OrderCreated schema, to encode a test event exactly as order-service's outbox does
             (this service publishes nothing, so it needs no schemas at runtime) -->
        <dependency>
            <groupId>com.grocery</groupId>
            <artifactId>grocery-event-schemas</artifactId>
            <version>${grocery-event-schemas.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Contract tests (Phase 13 §4, file-based, no broker): consumer pacts for the six services the cart reads,
             written to contracts/pacts, and verification of order-service's pact against this service (MockMvc) -->
        <dependency>
            <groupId>au.com.dius.pact.consumer</groupId>
            <artifactId>junit5</artifactId>
            <version>4.7.7</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>au.com.dius.pact.provider</groupId>
            <artifactId>spring7</artifactId>
            <version>4.7.7</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <dependencyManagement>
        <dependencies>
            <!-- security-pins: fixed versions of jars that kafka-clients and the Confluent serializer bring in (Trivy
                 HIGH, fix available; tests/security). Drop each pin once the parent library ships the fix. -->
            <dependency>
                <groupId>com.google.guava</groupId>
                <artifactId>guava</artifactId>
                <version>33.7.2-jre</version>
            </dependency>
            <dependency>
                <groupId>at.yawk.lz4</groupId>
                <artifactId>lz4-java</artifactId>
                <version>1.11.4</version>
            </dependency>
            <dependency>
                <groupId>org.xerial.snappy</groupId>
                <artifactId>snappy-java</artifactId>
                <version>1.1.10.9</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <!-- Pact consumer tests write contracts/pacts/cart-service-<provider>.json at the repository
                             root (absolute, so it resolves from any working directory); regenerated, not merged -->
                        <pact.rootDir>${project.basedir}/../../contracts/pacts</pact.rootDir>
                        <pact.writer.overwrite>true</pact.writer.overwrite>
                        <!-- no anonymous usage tracking calls from tests -->
                        <pact_do_not_track>true</pact_do_not_track>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
