<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>com.grocery</groupId>
    <artifactId>order-service</artifactId>
    <version>0.12.0-SNAPSHOT</version>
    <name>order-service</name>
    <description>Orders with a price snapshot, idempotent order creation, the order status and its history, cancellation rules and order stats; publishes order events through the outbox and follows inventory, payment, store (vendor / restaurant) and delivery events; finds stuck orders and keeps every order's event timeline; refuses an order whose cart changed since the preview the customer approved; redeems the cart's coupon at placement and handles returns with prorated partial refunds</description>

    <properties>
        <java.version>25</java.version>
        <grocery-common.version>0.10.1</grocery-common.version>
        <spring-ai.version>2.0.2</spring-ai.version>
        <grocery-event-schemas.version>1.8.0</grocery-event-schemas.version>
        <spring-cloud.version>2025.1.4</spring-cloud.version>
    </properties>

    <!-- grocery-common's Avro serdes and Schema Registry client come from Confluent's repository (ADR-0011);
         Maven Central stays the default for everything else. -->
    <repositories>
        <repository>
            <id>confluent</id>
            <url>https://packages.confluent.io/maven/</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>com.grocery</groupId>
            <artifactId>grocery-common</artifactId>
            <version>${grocery-common.version}</version>
        </dependency>
        <!-- The central Avro schemas the outbox validates and encodes order.events with (resource-only jar) -->
        <dependency>
            <groupId>com.grocery</groupId>
            <artifactId>grocery-event-schemas</artifactId>
            <version>${grocery-event-schemas.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <!-- MCP pilot (2026-11-20): order status as an MCP tool over stateless Streamable HTTP, behind the same JWT check -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-server-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-oauth2-resource-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-kafka</artifactId>
        </dependency>
        <!-- The checkout preview from cart-service, with the customer's own token -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-restclient</artifactId>
        </dependency>
        <!-- A circuit breaker around cart-service -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-circuitbreaker-resilience4j</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-oauth2-resource-server-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-mysql</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Event consumer contract tests (Phase 13 §4): samples generated from the schemas, shared helper -->
        <dependency>
            <groupId>com.grocery</groupId>
            <artifactId>grocery-event-schemas</artifactId>
            <version>${grocery-event-schemas.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <!-- Contract tests (Phase 13 §4): consumer pacts for cart-service and pricing-service, written to
             contracts/pacts (file-based, no broker) -->
        <dependency>
            <groupId>au.com.dius.pact.consumer</groupId>
            <artifactId>junit5</artifactId>
            <version>4.7.7</version>
            <scope>test</scope>
        </dependency>
        <!-- Reads the exported workbooks back (grocery-common 0.10.0 exports) -->
        <dependency>
            <groupId>org.dhatim</groupId>
            <artifactId>fastexcel-reader</artifactId>
            <version>0.20.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <dependencyManagement>
        <dependencies>
            <!-- security-pins: fixed versions of jars that kafka-clients and the Confluent serializer bring in (Trivy
                 HIGH, fix available; tests/security). Drop each pin once the parent library ships the fix. -->
            <dependency>
                <groupId>com.google.guava</groupId>
                <artifactId>guava</artifactId>
                <version>33.7.2-jre</version>
            </dependency>
            <dependency>
                <groupId>at.yawk.lz4</groupId>
                <artifactId>lz4-java</artifactId>
                <version>1.11.4</version>
            </dependency>
            <dependency>
                <groupId>org.xerial.snappy</groupId>
                <artifactId>snappy-java</artifactId>
                <version>1.1.10.9</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <!-- Pact consumer tests write contracts/pacts/order-service-<provider>.json at the repository
                             root (absolute, so it resolves from any working directory); regenerated, not merged -->
                        <pact.rootDir>${project.basedir}/../../contracts/pacts</pact.rootDir>
                        <pact.writer.overwrite>true</pact.writer.overwrite>
                        <!-- no anonymous usage tracking calls from tests -->
                        <pact_do_not_track>true</pact_do_not_track>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
