<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>com.grocery</groupId>
    <artifactId>ai-orchestrator-service</artifactId>
    <version>0.12.0-SNAPSHOT</version>
    <name>ai-orchestrator-service</name>
    <description>Phase 11: the Shopping and Admin BI assistants (Spring AI tool calling through ToolGuard, chat memory,
        structured insights) and human approval of sensitive actions (signed approval tokens, exactly-once execution
        through the gateway); publishes ai.events through the outbox</description>

    <properties>
        <java.version>25</java.version>
        <grocery-common.version>0.10.1</grocery-common.version>
        <grocery-event-schemas.version>1.8.0</grocery-event-schemas.version>
        <spring-ai.version>2.0.2</spring-ai.version>
        <!-- The OkHttp the OpenTelemetry OTLP exporter (Spring Boot 4.1.2) uses; the Anthropic client shares it. -->
        <okhttp.version>5.3.2</okhttp.version>
    </properties>

    <!-- grocery-common's Avro serdes and Schema Registry client come from Confluent's repository (ADR-0011);
         Maven Central stays the default for everything else (Spring AI included). -->
    <repositories>
        <repository>
            <id>confluent</id>
            <url>https://packages.confluent.io/maven/</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>com.grocery</groupId>
            <artifactId>grocery-common</artifactId>
            <version>${grocery-common.version}</version>
        </dependency>
        <!-- The central Avro schemas the outbox validates and encodes ai.events with (resource-only jar) -->
        <dependency>
            <groupId>com.grocery</groupId>
            <artifactId>grocery-event-schemas</artifactId>
            <version>${grocery-event-schemas.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- JWT resource server (grocery-common's chain); also brings Nimbus JOSE, used to sign approval tokens -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-oauth2-resource-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- grocery-common encodes outbox payloads as Avro with Confluent's serializer, which needs the Kafka client
             classes; this service consumes nothing, so no Spring Kafka (Debezium publishes the outbox). -->
        <dependency>
            <groupId>org.apache.kafka</groupId>
            <artifactId>kafka-clients</artifactId>
        </dependency>
        <!-- Tools and approval execution call the business APIs through the gateway -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-restclient</artifactId>
        </dependency>

        <!-- Spring AI: ChatClient, tool calling, structured output, the Ollama chat model -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-ollama</artifactId>
        </dependency>
        <!-- The production model (AI_PROVIDER=anthropic): Claude through Anthropic's Messages API (official Java SDK) -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-anthropic</artifactId>
            <exclusions>
                <!-- OkHttp 4.12 next to the OpenTelemetry exporter's OkHttp 5 put two okhttp3 packages and an old okio
                     (3.6) on the classpath: NoSuchMethodError okio.Okio.socket. One OkHttp 5 for both, below. -->
                <exclusion>
                    <groupId>com.squareup.okhttp3</groupId>
                    <artifactId>okhttp</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp-jvm</artifactId>
            <version>${okhttp.version}</version>
        </dependency>
        <!-- MCP pilot (2026-11-20): the MCP Java SDK's client for the tools catalog-query and order-service publish
             (the library only: no auto-configured clients or tool callbacks; McpGateway builds the clients) -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-mcp</artifactId>
        </dependency>
        <!-- Chat memory in ai_db (table created by Flyway, never by schema initialisation) -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-chat-memory-repository-jdbc</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-oauth2-resource-server-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-mysql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <dependencyManagement>
        <dependencies>
            <!-- security-pins: fixed versions of jars that kafka-clients and the Confluent serializer bring in (Trivy
                 HIGH, fix available; tests/security). Drop each pin once the parent library ships the fix. -->
            <dependency>
                <groupId>com.google.guava</groupId>
                <artifactId>guava</artifactId>
                <version>33.7.2-jre</version>
            </dependency>
            <dependency>
                <groupId>at.yawk.lz4</groupId>
                <artifactId>lz4-java</artifactId>
                <version>1.11.4</version>
            </dependency>
            <dependency>
                <groupId>org.xerial.snappy</groupId>
                <artifactId>snappy-java</artifactId>
                <version>1.1.10.9</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
