      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(increase(grocery_ai_knowledge_retrievals_total{outcome=\"NO_MATCH\",source!=\"unrecognised\"}[1h])) / clamp_min(sum(increase(grocery_ai_knowledge_retrievals_total{outcome=~\"HIT|NO_MATCH\",source!=\"unrecognised\"}[1h])), 1)",
          "legendFormat": "No-match share (1 h)",
          "range": true,
