# Copy to .env (same folder) to override defaults. Local development only — never commit real secrets.
# Every value below already has a default inside docker-compose.yml, so .env is optional.

# ---- Which host addresses the published ports listen on (Phase 13 security scan)
# Infrastructure (MySQL root/root, Redis, Kafka, ES, Connect ...), the services' direct ports and the observability UIs
# listen on this machine only. Set 0.0.0.0 only on a trusted network, e.g. to reach Grafana from another device.
BIND_ADDRESS=127.0.0.1
# The gateway and the frontend (the app itself) stay reachable from the network, e.g. a phone testing the partner app.
PUBLIC_BIND_ADDRESS=0.0.0.0

# ---- Host ports (change if something on Windows already uses them)
MYSQL_HOST_PORT=3307          # 3306 is often taken by a Windows MySQL service
KAFKA_HOST_PORT=9092
CONNECT_HOST_PORT=8083
SCHEMA_REGISTRY_HOST_PORT=8081   # Confluent Schema Registry (Avro event schemas)
REDIS_HOST_PORT=6379
KAFKA_UI_HOST_PORT=8070
ES_HOST_PORT=9200
OLLAMA_HOST_PORT=11434
GATEWAY_HOST_PORT=8080
AI_ORCHESTRATOR_HOST_PORT=8115   # Phase 11 ai-orchestrator-service (direct access; the app goes through the gateway)
FRONTEND_HOST_PORT=6420
FRONTEND_UI_HOST_PORT=6421         # JavaScript copy of the web app (profile `frontend-ui`)
MAILPIT_UI_PORT=8025             # Phase 12 Mailpit web UI (caught emails); its SMTP port 1025 stays inside Docker
# Phase 13 observability (profile `observability`): where the Spring Boot services run, host ports, local credentials
SERVICES_RUN_ON=docker           # docker (containers) or host (host-run/start-all.cmd): what Prometheus scrapes
PROMETHEUS_HOST_PORT=9090
ALERTMANAGER_HOST_PORT=9093
GRAFANA_HOST_PORT=3000
GRAFANA_ADMIN_PASSWORD=admin     # local only
MYSQL_MONITORING_PASSWORD=monitoring_pass   # read-only exporter user (03-monitoring-user.sql); local only

# ---- Credentials (must match the scripts in infrastructure/local/mysql/init/: 01-databases-and-users.sql, and
#      02-reporting-db.sql for reporting_user). The mysql-init one-shot re-applies them on every start.
MYSQL_ROOT_PASSWORD=root
DEBEZIUM_DB_PASSWORD=debezium_pass
IDENTITY_DB_PASSWORD=identity_pass
CUSTOMER_DB_PASSWORD=customer_pass
VENDOR_DB_PASSWORD=vendor_pass
RESTAURANT_DB_PASSWORD=restaurant_pass
DELIVERY_DB_PASSWORD=delivery_pass
CATALOG_DB_PASSWORD=catalog_pass
INVENTORY_DB_PASSWORD=inventory_pass
PRICING_DB_PASSWORD=pricing_pass
ORDER_DB_PASSWORD=order_pass
PAYMENT_DB_PASSWORD=payment_pass
NOTIFICATION_DB_PASSWORD=notification_pass
AI_DB_PASSWORD=ai_pass
REVIEW_DB_PASSWORD=review_pass
REPORTING_DB_PASSWORD=reporting_pass

# ---- Pricing: a selling-price change above this percentage needs an admin (Phase 4)
PRICING_APPROVAL_THRESHOLD_PERCENT=20

# ---- First SUPER_ADMIN (created by identity-service only when no SUPER_ADMIN exists)
BOOTSTRAP_ADMIN_EMAIL=admin@grocery.local
BOOTSTRAP_ADMIN_PASSWORD=Admin@12345

# ---- Development accounts (local only): identity-service creates dev.customer / dev.vendor / dev.restaurant /
#      dev.delivery / dev.ops / dev.finance / dev.support / dev.delivery-manager @grocery.local, password Dev@12345,
#      and the sign-in screen of the dev frontend lists them. Existing accounts are never changed.
DEV_SEED_ENABLED=true
VITE_DEV_ACCOUNTS=true               # false hides the "Dev accounts" section on the sign-in screen

# ---- Kafka (KRaft) cluster id: any 22-char base64-url string, fixed so the volume can be reused
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# ---- Gateway
GATEWAY_ALLOWED_ORIGINS=http://localhost:6420

# ---- AI assistants & human approval (Phase 11)
# Model provider: "ollama" (start with --profile ai; any tool-calling capable model) or "scripted" (a deterministic
# stand-in that needs no model; local/docker only — used by smoke-phase11.sh with --profile assistant).
AI_PROVIDER=ollama
OLLAMA_MODEL=qwen3:4b-instruct
AI_MODEL_TIMEOUT=120s                # CPU inference is slow
# Knowledge base (RAG, docs/rag/RAG-LOCAL-SETUP.md): help-center articles in Elasticsearch (--profile search), embedded
# by Ollama. OLLAMA_EMBEDDING_MODEL= (empty) skips pulling the embedding model.
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
AI_KNOWLEDGE_ENABLED=true
AI_KNOWLEDGE_SEED=true               # load the starter help-center articles into an empty knowledge base
# How long a proposal waits for a human decision, and how often overdue ones are marked EXPIRED
AI_APPROVAL_TTL_CUSTOMER=15m         # PLACE_ORDER, CANCEL_ORDER (the customer decides)
AI_APPROVAL_TTL_ADMIN=24h            # refunds, admin cancels, suspensions
AI_APPROVAL_EXPIRY_INTERVAL=30s
AI_FOUR_EYES_REFUND_ABOVE=2000.00    # a larger refund must be approved by someone other than the requester
AI_MESSAGES_PER_HOUR=30              # chat messages per user
AI_REFUND_TIMELINE="5–7 working days"  # what the payment assistant says about bank refund timing (empty = nothing)
# PEM private key that signs X-Approval-Token. Leave it unset locally: a key is generated at startup (fine for one
# replica). Production uses a shared key from the secrets store. Never put a real key in this file.
# AI_APPROVAL_SIGNING_KEY=
# Voice chat in the assistant panel (microphone + "Listen"):
#   browser = the browser's own speech recognition and synthesis (no setup; Chrome, Edge, Safari)
#   server  = this platform transcribes and speaks: start speaches with --profile voice (CPU, local), or point
#             AI_VOICE_BASE_URL at https://api.openai.com/v1 with AI_VOICE_API_KEY and OpenAI's model names
#             (whisper-1, tts-1, alloy)
#   off     = no voice
AI_VOICE_MODE=browser
SPEACHES_HOST_PORT=8000
# AI_VOICE_BASE_URL=http://speaches:8000/v1
# AI_VOICE_TRANSCRIPTION_MODEL=Systran/faster-whisper-small
# AI_VOICE_SPEECH_MODEL=speaches-ai/Kokoro-82M-v1.0-ONNX
# AI_VOICE_SPEECH_VOICE=af_heart
# AI_VOICE_API_KEY=

# ---- Payments (Phase 6): Razorpay TEST mode keys (Dashboard → Test Mode → API Keys; webhook secret is the one you
# set on the webhook). Leave them empty to use the built-in payment simulator (local only). Never use live keys here.
# Webhooks cannot reach localhost directly; payment-service also confirms payments by asking Razorpay (verify + poller).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=xxx

# ---- Order timing (Phase 6). Shorten only to try the payment timeout (smoke-phase6.sh uses 45s / 5s).
ORDER_PAYMENT_WINDOW=15m
PAYMENT_EXPIRY_POLL_INTERVAL=30s
RESERVATION_TTL=20m

# ---- Store fulfilment (Phase 8): a store must accept a paid order within ACCEPTANCE_TIMEOUT, else it is auto-rejected
ACCEPTANCE_TIMEOUT=5m
ACCEPTANCE_POLL_INTERVAL=15s

# ---- Delivery (Phase 9): offers to the nearest online partners, search radii, location freshness
DELIVERY_OFFER_TTL=30s
DELIVERY_OFFER_BATCH_SIZE=2
DELIVERY_SEARCH_RADII_KM=3,6,10
DELIVERY_POLL_INTERVAL=5s
DELIVERY_RETRY_INTERVAL=60s
DELIVERY_LOCATION_STALE_AFTER=60s

# ---- Reviews (Phase 12): how long after delivery an order's items, store and partner can be reviewed
REVIEW_WINDOW=30d

# ---- Returns (Phase 12): request window after delivery, store decision time (then escalated to admins), poller
ORDER_RETURN_WINDOW=48h
RETURN_DECISION_TIMEOUT=24h
RETURN_ESCALATION_INTERVAL=1m

# ---- Complaints (Help & support): open complaints a customer may have at once
ORDER_COMPLAINTS_MAX_OPEN=5

# ---- Coupons (Phase 12): a coupon reserved for an order that was never saved is released after this
COUPON_RESERVATION_TTL=30m

# ---- Email (Phase 12): notification-service sends through Mailpit locally (profiles realtime, realtime-ha, all).
# false = in-app notifications only. Links in emails start with APP_BASE_URL. Production uses a real SMTP server or
# provider (SPRING_MAIL_* — never put real SMTP credentials in this file).
MAIL_ENABLED=true
APP_BASE_URL=http://localhost:6420

# ---- Database backups: the db-backup container exports every service database once a day (README "Database
# backups"). BACKUP_DIR is relative to this folder; daily exports older than BACKUP_KEEP_DAYS are deleted
# (manual and before-restore exports are kept). BACKUP_TIME is a 24-hour time in BACKUP_TIMEZONE; when the machine
# is off then, the export is made as soon as Docker runs again that day.
BACKUP_DIR=./backups
BACKUP_TIME=00:00
BACKUP_TIMEZONE=Asia/Kolkata
BACKUP_KEEP_DAYS=14
