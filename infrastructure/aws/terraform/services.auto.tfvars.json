{
  "_comment": "Single definition of the 19 deployable units (17 Spring Boot services + Confluent Schema Registry on ECS Fargate, plus the web SPA on S3/CloudFront) and the one-off tasks. Derived from infrastructure/local/docker-compose.yml. Read by envs/<env>/main.tf with jsondecode(file(...)); sizes here are the production baseline, envs/<env>/<env>.tfvars scale them down. Tokens {{...}} in environment values are resolved per environment by modules/platform. Infrastructure endpoints (DB_HOST, KAFKA_BOOTSTRAP_SERVERS, REDIS_HOST, ELASTICSEARCH_URIS, OTEL_EXPORTER_OTLP_ENDPOINT ...) are injected from the 'needs' flags, not listed here.",
  "services": {
    "api-gateway": {
      "kind": "ecs",
      "runtime": "spring-boot",
      "description": "Edge: routing, JWT validation, rate limiting (Redis). The only unit behind the ALB (/api/* from CloudFront).",
      "image_repository": "grocery/api-gateway",
      "port": 8080,
      "cpu": 1024,
      "memory": 2048,
      "desired_count": 2,
      "max_count": 8,
      "health_check_path": "/api/health/gateway",
      "container_health_check": "wget -qO- http://127.0.0.1:9080/actuator/health/liveness >/dev/null || exit 1",
      "metrics_port": 9080,
      "metrics_path": "/actuator/prometheus",
      "adot": true,
      "read_only_root_filesystem": true,
      "load_balancer": { "listener_port": 443, "test_listener_port": 8443, "from_cloudfront": true },
      "service_connect_timeouts": { "idle_seconds": 3600, "per_request_seconds": 0 },
      "needs": { "database": false, "kafka": false, "redis": true, "elasticsearch": false, "schema_registry": false, "approval_jwks": false },
      "database": null,
      "debezium_connector": null,
      "environment": {
        "GATEWAY_ALLOWED_ORIGINS": "{{app_url}}",
        "GATEWAY_TRUSTED_PROXIES": "2",
        "IDENTITY_SERVICE_URL": "http://identity-service:8101",
        "CUSTOMER_SERVICE_URL": "http://customer-service:8102",
        "VENDOR_SERVICE_URL": "http://vendor-service:8103",
        "RESTAURANT_SERVICE_URL": "http://restaurant-service:8104",
        "CATALOG_COMMAND_SERVICE_URL": "http://catalog-command-service:8105",
        "CATALOG_QUERY_SERVICE_URL": "http://catalog-query-service:8106",
        "INVENTORY_SERVICE_URL": "http://inventory-service:8107",
        "PRICING_SERVICE_URL": "http://pricing-service:8108",
        "CART_SERVICE_URL": "http://cart-service:8109",
        "ORDER_SERVICE_URL": "http://order-service:8110",
        "PAYMENT_SERVICE_URL": "http://payment-service:8111",
        "DELIVERY_SERVICE_URL": "http://delivery-service:8112",
        "NOTIFICATION_SERVICE_URL": "http://notification-service:8113",
        "REVIEW_SERVICE_URL": "http://review-service:8114",
        "AI_ORCHESTRATOR_SERVICE_URL": "http://ai-orchestrator-service:8115",
        "REPORTING_SERVICE_URL": "http://reporting-service:8116"
      },
      "secrets": { "REDIS_AUTH": "redis:auth_token" },
      "app_secrets": {},
      "depends_on": ["redis", "identity-service"]
    },
    "identity-service": {
      "kind": "ecs",
      "runtime": "spring-boot",
      "description": "Accounts, login, RS256 JWT issuing (signing keys live in identity_db), JWKS.",
      "image_repository": "grocery/identity-service",
      "port": 8101,
      "cpu": 512,
      "memory": 1024,
      "desired_count": 2,
      "max_count": 6,
      "health_check_path": "/actuator/health/readiness",
      "container_health_check": "wget -qO- http://127.0.0.1:8101/actuator/health/liveness >/dev/null || exit 1",
      "metrics_path": "/actuator/prometheus",
      "adot": true,
      "read_only_root_filesystem": true,
      "load_balancer": null,
      "service_connect_timeouts": null,
      "needs": { "database": true, "kafka": true, "redis": true, "elasticsearch": false, "schema_registry": true, "approval_jwks": false },
      "database": { "name": "identity_db", "user": "identity_user" },
      "debezium_connector": "services/identity-service/deploy/debezium-connector.json",
      "environment": { "BOOTSTRAP_ADMIN_EMAIL": "{{bootstrap_admin_email}}" },
      "secrets": {
        "DB_USERNAME": "db:username",
        "DB_PASSWORD": "db:password",
        "KAFKA_SASL_USERNAME": "kafka:username",
        "KAFKA_SASL_PASSWORD": "kafka:password",
        "REDIS_AUTH": "redis:auth_token",
        "BOOTSTRAP_ADMIN_PASSWORD": "bootstrap-admin:password"
      },
      "app_secrets": { "bootstrap-admin": { "type": "random_password", "keys": ["password"] } },
      "depends_on": ["mysql", "kafka", "redis", "schema-registry"]
    },
    "customer-service": {
