        "KAFKA_SASL_PASSWORD": "kafka:password",
        "REDIS_AUTH": "redis:auth_token",
        "SPRING_MAIL_USERNAME": "smtp:username",
        "SPRING_MAIL_PASSWORD": "smtp:password"
      },
      "app_secrets": { "smtp": { "type": "placeholder", "keys": ["username", "password"] } },
      "depends_on": ["mysql", "kafka", "redis", "schema-registry"]
    },
    "review-service": {
      "kind": "ecs",
      "runtime": "spring-boot",
      "description": "Reviews, moderation, store replies, rating summaries -> review.events (outbox).",
      "image_repository": "grocery/review-service",
      "port": 8114,
      "cpu": 512,
      "memory": 1024,
      "desired_count": 2,
      "max_count": 4,
      "health_check_path": "/actuator/health/readiness",
      "container_health_check": "wget -qO- http://127.0.0.1:8114/actuator/health/liveness >/dev/null || exit 1",
      "metrics_path": "/actuator/prometheus",
      "adot": true,
      "read_only_root_filesystem": true,
      "load_balancer": null,
      "service_connect_timeouts": null,
      "needs": { "database": true, "kafka": true, "redis": false, "elasticsearch": false, "schema_registry": true, "approval_jwks": false },
      "database": { "name": "review_db", "user": "review_user" },
      "debezium_connector": "services/review-service/deploy/debezium-connector.json",
      "environment": { "REVIEW_WINDOW": "30d", "REVIEW_EDIT_WINDOW": "7d" },
      "secrets": {
        "DB_USERNAME": "db:username",
        "DB_PASSWORD": "db:password",
        "KAFKA_SASL_USERNAME": "kafka:username",
        "KAFKA_SASL_PASSWORD": "kafka:password"
      },
      "app_secrets": {},
      "depends_on": ["mysql", "kafka", "schema-registry"]
    },
    "reporting-service": {
      "kind": "ecs",
      "runtime": "spring-boot",
      "description": "Read model built only from events; admin reports and CSV exports. Publishes no events.",
      "image_repository": "grocery/reporting-service",
      "port": 8116,
      "cpu": 512,
      "memory": 1024,
      "desired_count": 2,
      "max_count": 4,
      "health_check_path": "/actuator/health/readiness",
      "container_health_check": "wget -qO- http://127.0.0.1:8116/actuator/health/liveness >/dev/null || exit 1",
      "metrics_path": "/actuator/prometheus",
      "adot": true,
      "read_only_root_filesystem": true,
      "load_balancer": null,
      "service_connect_timeouts": null,
      "needs": { "database": true, "kafka": true, "redis": false, "elasticsearch": false, "schema_registry": true, "approval_jwks": false },
      "database": { "name": "reporting_db", "user": "reporting_user" },
      "debezium_connector": null,
      "environment": {},
      "secrets": {
        "DB_USERNAME": "db:username",
        "DB_PASSWORD": "db:password",
        "KAFKA_SASL_USERNAME": "kafka:username",
        "KAFKA_SASL_PASSWORD": "kafka:password"
      },
      "app_secrets": {},
      "depends_on": ["mysql", "kafka", "schema-registry"]
    },
    "ai-orchestrator-service": {
      "kind": "ecs",
      "runtime": "spring-boot",
      "description": "Spring AI assistants, ToolGuard, human approvals (RS256 approval tokens) -> ai.events (outbox). Claude through Anthropic's API (key in Secrets Manager); without a key the chat answers AI_UNAVAILABLE.",
      "image_repository": "grocery/ai-orchestrator-service",
      "port": 8115,
      "cpu": 1024,
      "memory": 2048,
      "desired_count": 2,
      "max_count": 4,
      "health_check_path": "/actuator/health/readiness",
      "container_health_check": "wget -qO- http://127.0.0.1:8115/actuator/health/liveness >/dev/null || exit 1",
      "metrics_path": "/actuator/prometheus",
      "adot": true,
      "read_only_root_filesystem": true,
      "load_balancer": null,
      "service_connect_timeouts": { "idle_seconds": 3600, "per_request_seconds": 0 },
      "needs": { "database": true, "kafka": false, "redis": false, "elasticsearch": false, "schema_registry": true, "approval_jwks": false },
      "database": { "name": "ai_db", "user": "ai_user" },
      "debezium_connector": "services/ai-orchestrator-service/deploy/debezium-connector.json",
      "environment": {
        "GROCERY_AI_GATEWAY_URL": "http://api-gateway:8080",
        "AI_PROVIDER": "{{ai_provider}}",
        "OLLAMA_BASE_URL": "{{ollama_base_url}}",
        "OLLAMA_MODEL": "{{ollama_model}}",
        "ANTHROPIC_MODEL": "{{anthropic_model}}",
        "AI_MODEL_TIMEOUT": "180s",
        "AI_APPROVAL_TTL_CUSTOMER": "15m",
        "AI_APPROVAL_TTL_ADMIN": "24h",
        "AI_FOUR_EYES_REFUND_ABOVE": "2000.00",
        "AI_MESSAGES_PER_HOUR": "30",
        "AI_APPROVAL_EXPIRY_INTERVAL": "30s",
        "AI_VOICE_MODE": "off"
      },
      "secrets": {
        "DB_USERNAME": "db:username",
        "DB_PASSWORD": "db:password",
        "AI_APPROVAL_SIGNING_KEY": "approval-signing-key",
        "ANTHROPIC_API_KEY": "anthropic:api_key"
      },
      "app_secrets": {
        "approval-signing-key": { "type": "rsa_pkcs8", "keys": [] },
        "anthropic": { "type": "placeholder", "keys": ["api_key"] }
      },
      "depends_on": ["mysql", "schema-registry", "api-gateway"]
    },
    "schema-registry": {
      "kind": "ecs",
      "runtime": "confluent-schema-registry",
      "description": "Confluent Schema Registry backed by MSK (_schemas topic). Services reach it through Service Connect; schema-init and CI reach it through the internal ALB listener 8081.",
      "external_image": "confluentinc/cp-schema-registry:8.2.4",
      "port": 8081,
      "cpu": 512,
      "memory": 1024,
      "desired_count": 2,
      "max_count": 2,
      "health_check_path": "/subjects",
      "container_health_check": "curl -sf http://127.0.0.1:8081/subjects >/dev/null || exit 1",
      "metrics_path": null,
      "adot": false,
      "read_only_root_filesystem": false,
      "command": ["bash", "-c", "export SCHEMA_REGISTRY_HOST_NAME=\"$(hostname -i | cut -d' ' -f1)\"; exec /etc/confluent/docker/run"],
      "load_balancer": { "listener_port": 8081, "test_listener_port": 18081, "from_cloudfront": false },
      "service_connect_timeouts": null,
      "needs": { "database": false, "kafka": true, "redis": false, "elasticsearch": false, "schema_registry": false, "approval_jwks": false },
      "database": null,
      "debezium_connector": null,
      "environment": {
        "SCHEMA_REGISTRY_LISTENERS": "http://0.0.0.0:8081",
        "SCHEMA_REGISTRY_KAFKASTORE_BOOTSTRAP_SERVERS": "{{kafka_bootstrap_scram}}",
        "SCHEMA_REGISTRY_KAFKASTORE_SECURITY_PROTOCOL": "SASL_SSL",
        "SCHEMA_REGISTRY_KAFKASTORE_SASL_MECHANISM": "SCRAM-SHA-512",
        "SCHEMA_REGISTRY_KAFKASTORE_TOPIC": "_schemas",
        "SCHEMA_REGISTRY_KAFKASTORE_TOPIC_REPLICATION_FACTOR": "{{kafka_replication_factor}}",
        "SCHEMA_REGISTRY_SCHEMA_COMPATIBILITY_LEVEL": "backward_transitive",
        "SCHEMA_REGISTRY_LEADER_ELIGIBILITY": "true",
        "SCHEMA_REGISTRY_HEAP_OPTS": "-Xms256m -Xmx512m"
      },
      "secrets": { "SCHEMA_REGISTRY_KAFKASTORE_SASL_JAAS_CONFIG": "kafkastore-jaas:jaas_config" },
      "app_secrets": { "kafkastore-jaas": { "type": "kafka_jaas", "keys": ["jaas_config"] } },
      "depends_on": ["kafka"]
    },
    "web": {
      "kind": "spa",
      "runtime": "static",
      "description": "React SPA (frontend/grocery-web): Vite build uploaded to s3://<bucket>/releases/<sha>/ and served by CloudFront (infrastructure/ci/scripts/deploy-spa.sh). The nginx image (Dockerfile.prod) is pushed to ECR grocery/grocery-web for other targets.",
      "image_repository": "grocery/grocery-web",
      "depends_on": ["api-gateway"]
    }
  },
  "one_off_tasks": {
    "db-init": {
      "description": "Creates every service database and user (passwords from Secrets Manager), the Debezium user and grants, and sets binlog retention (mysql.rds_set_configuration). Idempotent: run after the first apply and whenever a service database is added.",
      "image": "public.ecr.aws/docker/library/mysql:8.4.13",
      "cpu": 256,
      "memory": 512
    },
    "kafka-init": {
      "description": "Creates the domain topics, their DLTs, delivery.location and _grocery.dead-letter-actions on MSK (same topic list as infrastructure/local/kafka/create-topics.sh; validate.sh checks they match). Idempotent.",
      "image": "apache/kafka:4.3.2",
      "cpu": 256,
      "memory": 1024
    },
    "schema-init": {
      "description": "Runs infrastructure/local/schema-registry/register-schemas.sh against the Schema Registry (internal ALB :8081). The image (ECR grocery/schema-init) is built by CI from libs/grocery-event-schemas + the script.",
      "image_repository": "grocery/schema-init",
      "cpu": 256,
      "memory": 512
    },
    "connector-registration": {
      "description": "Not an ECS task in AWS: every producing service's Debezium connector is an aws_mskconnect_connector rendered from services/<service>/deploy/debezium-connector.json (modules/msk-connect). Enable with debezium_connectors_enabled = true after db-init, kafka-init and the first service deployment.",
      "mode": "msk-connect"
    }
  },
  "kafka_topics": {
    "domain_topics": [
      "identity.events", "customer.events", "vendor.events", "restaurant.events",
      "catalog.events", "pricing.events", "inventory.events", "order.events",
      "payment.events", "delivery.events", "review.events", "ai.events"
    ],
    "domain_retention_ms": 604800000,
    "dlt_partitions": 1,
    "dlt_retention_ms": 2592000000,
    "extra_topics": {
      "delivery.location": { "partitions": 0, "config": { "retention.ms": "3600000" } },
      "_grocery.dead-letter-actions": { "partitions": 1, "config": { "cleanup.policy": "compact", "min.compaction.lag.ms": "60000" } }
    }
  }
}
