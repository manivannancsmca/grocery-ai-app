# Copy to .env (git-ignored) or export these before `docker compose up`. Local validation Jenkins only.
JENKINS_ADMIN_ID=admin
# required - choose your own; lint.sh and run-pipeline.sh read the same variable
JENKINS_ADMIN_PASSWORD=
# host ports (bound to 127.0.0.1 only)
JENKINS_PORT=8190
CI_REGISTRY_PORT=5000
# group owning /var/run/docker.sock: 0 on Docker Desktop; on Linux: stat -c %g /var/run/docker.sock
DOCKER_GID=0
