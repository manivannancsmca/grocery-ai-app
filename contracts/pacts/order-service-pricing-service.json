          }
        }
      ],
      "request": {
        "body": {
          "content": {
            "code": "BIG100",
            "customerId": "0193f1a2-5b6c-7d8e-9f01-a2b3c4d5e601",
            "deliveryFee": 25.00,
            "orderId": "0193f1a2-5b6c-7d8e-9f01-a2b3c4d5e6d1",
            "orderType": "GROCERY",
            "storeId": "0193f1a2-5b6c-7d8e-9f01-a2b3c4d5e6b1",
            "subtotal": 360.00
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Authorization": [
            "Bearer contract-test-token"
          ],
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.customerId": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
                }
              ]
            },
            "$.deliveryFee": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "number"
                }
              ]
            },
            "$.orderId": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
                }
              ]
            },
            "$.orderType": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "GROCERY|RESTAURANT"
                }
              ]
            },
            "$.storeId": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
                }
              ]
            },
            "$.subtotal": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "number"
                }
              ]
            }
          },
          "header": {
            "Authorization": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^Bearer \\S+$"
                }
              ]
            },
            "Content-Type": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^application/json.*"
                }
              ]
            }
          }
        },
        "method": "POST",
        "path": "/internal/coupons/redeem"
      },
      "response": {
        "body": {
          "content": {
            "errorCode": "COUPON_NOT_APPLICABLE",
            "minOrderSubtotal": 499.00,
            "reason": "COUPON_MIN_ORDER"
          },
          "contentType": "application/problem+json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/problem+json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.minOrderSubtotal": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "number"
                }
              ]
            }
          },
          "header": {
            "Content-Type": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^application/problem\\+json.*"
                }
              ]
            }
          }
        },
        "status": 409
      },
      "transport": "http",
      "type": "Synchronous/HTTP"
    },
