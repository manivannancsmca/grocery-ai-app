    {
      "description": "a redemption of a coupon the order is too small for",
      "key": "218c0f7a",
      "pending": false,
      "providerStates": [
        {
          "name": "coupon BIG100 needs a minimum order of 499.00",
          "params": {
            "code": "BIG100",
            "customerId": "0193f1a2-5b6c-7d8e-9f01-a2b3c4d5e601",
            "orderId": "0193f1a2-5b6c-7d8e-9f01-a2b3c4d5e6d1",
