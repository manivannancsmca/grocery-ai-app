{
  "consumer": {
    "name": "cart-service"
  },
  "interactions": [
    {
      "description": "an availability check of a stocked and an unknown product",
      "key": "e69ea1c0",
      "pending": false,
      "providerStates": [
        {
          "name": "a product has 12 units available and another product is unknown",
          "params": {
            "missingProductId": "0193f1a2-5b6c-7d8e-9f01-a2b3c4d5e6c9",
            "productId": "0193f1a2-5b6c-7d8e-9f01-a2b3c4d5e6c1",
            "vendorId": "0193f1a2-5b6c-7d8e-9f01-a2b3c4d5e6b1"
          }
        }
      ],
      "request": {
        "body": {
          "content": {
            "productIds": [
              "0193f1a2-5b6c-7d8e-9f01-a2b3c4d5e6c1",
              "0193f1a2-5b6c-7d8e-9f01-a2b3c4d5e6c9"
            ]
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Authorization": [
            "Bearer contract-test-token"
          ],
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.productIds[0]": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
                }
              ]
            },
            "$.productIds[1]": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
                }
              ]
            }
          },
          "header": {
            "Authorization": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^Bearer \\S+$"
                }
              ]
            },
            "Content-Type": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^application/json.*"
                }
              ]
            }
          }
        },
        "method": "POST",
        "path": "/internal/inventory/availability"
      },
      "response": {
        "body": {
          "content": {
            "items": [
              {
                "available": 12,
                "inStock": true,
                "productId": "0193f1a2-5b6c-7d8e-9f01-a2b3c4d5e6c1",
                "vendorId": "0193f1a2-5b6c-7d8e-9f01-a2b3c4d5e6b1"
              }
            ],
            "missing": [
              "0193f1a2-5b6c-7d8e-9f01-a2b3c4d5e6c9"
            ]
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.items": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.items[*].available": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.items[*].inStock": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.items[*].productId": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
                }
              ]
            },
            "$.items[*].vendorId": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
                }
              ]
            },
            "$.missing[0]": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
                }
              ]
            }
          },
          "header": {
            "Content-Type": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^application/json.*"
                }
              ]
            }
          }
        },
        "status": 200
      },
      "transport": "http",
      "type": "Synchronous/HTTP"
    }
  ],
  "metadata": {
    "pact-jvm": {
      "version": "4.7.7"
    },
    "pactSpecification": {
      "version": "4.0"
    }
  },
  "provider": {
    "name": "inventory-service"
  }
}
