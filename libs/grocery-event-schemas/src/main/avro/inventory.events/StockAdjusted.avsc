{
  "type": "record",
  "name": "StockAdjusted",
  "namespace": "com.grocery.events.inventory",
  "doc": "A vendor (or admin) adjusted a product's stock. Published for every adjustment. Producer: inventory-service, topic inventory.events (aggregate Stock), key productId.",
  "fields": [
    {"name": "productId", "type": {"type": "string", "logicalType": "uuid"}, "doc": "Id of the product (message key)."},
    {"name": "vendorId", "type": {"type": "string", "logicalType": "uuid"}, "doc": "Id of the vendor that owns the stock."},
    {"name": "movementId", "type": {"type": "string", "logicalType": "uuid"}, "doc": "Id of the stock movement recorded for this adjustment."},
    {"name": "type", "type": "string", "doc": "Adjustment type. One of: INCREASE, DECREASE, SET (the movement types RESERVE, RELEASE and COMMIT are never published here)."},
    {"name": "delta", "type": "int", "doc": "Signed change of the on-hand quantity."},
    {"name": "onHand", "type": "int", "doc": "On-hand quantity after the adjustment."},
    {"name": "reserved", "type": "int", "doc": "Quantity held by order reservations after the adjustment."},
    {"name": "available", "type": "int", "doc": "Available quantity after the adjustment (onHand - reserved)."},
    {"name": "reason", "type": ["null", "string"], "default": null, "doc": "Adjustment reason. One of: RESTOCK, RETURN, DAMAGED, EXPIRED, STOCK_COUNT, CORRECTION, OTHER; null when none was given."},
    {"name": "actorUserId", "type": ["null", {"type": "string", "logicalType": "uuid"}], "default": null, "doc": "User who made the adjustment; null for a system change."},
    {"name": "stockVersion", "type": "long", "doc": "Strictly increasing per product with every stock change."}
  ]
}
