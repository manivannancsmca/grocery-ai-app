{
  "type": "record",
  "name": "ReturnRejected",
  "namespace": "com.grocery.events.order",
  "doc": "A return was rejected by the store or an admin; nothing is refunded. Producer: order-service, topic order.events, key orderId.",
  "fields": [
    {
      "name": "returnId",
      "type": {
        "type": "string",
        "logicalType": "uuid"
      },
      "doc": "Id of the return request."
    },
    {
      "name": "returnNumber",
      "type": "string",
      "doc": "Human-readable return number, e.g. RT-7K3M9QX2."
    },
    {
      "name": "orderId",
      "type": {
        "type": "string",
        "logicalType": "uuid"
      },
      "doc": "Id of the order (message key)."
    },
    {
      "name": "orderNumber",
      "type": "string",
      "doc": "Human-readable order number."
    },
    {
      "name": "orderType",
      "type": "string",
      "doc": "Store type of the order. One of: GROCERY, RESTAURANT."
    },
    {
      "name": "customerId",
      "type": {
        "type": "string",
        "logicalType": "uuid"
      },
      "doc": "Id of the customer."
    },
    {
      "name": "storeId",
      "type": {
        "type": "string",
        "logicalType": "uuid"
      },
      "doc": "vendorId for a GROCERY order, restaurantId for a RESTAURANT order."
    },
    {
      "name": "comment",
      "type": "string",
      "doc": "Why it was rejected, shown to the customer."
    },
    {
      "name": "decidedBy",
      "type": {
        "type": "string",
        "logicalType": "uuid"
      },
      "doc": "User who rejected it."
    },
    {
      "name": "decidedByRole",
      "type": "string",
      "doc": "One of: STORE, ADMIN."
    },
    {
      "name": "decidedAt",
      "type": {
        "type": "long",
        "logicalType": "timestamp-micros"
      },
      "doc": "When it was rejected (UTC)."
    }
  ]
}
