{
  "type": "record",
  "name": "DeliveryPartnerUnassigned",
  "namespace": "com.grocery.events.delivery",
  "doc": "An admin took the delivery away from its partner before pickup (reassignment). Producer: delivery-service, topic delivery.events, key orderId (outbox aggregate type Delivery).",
  "fields": [
    {"name": "deliveryId", "type": {"type": "string", "logicalType": "uuid"}, "doc": "Id of the delivery."},
    {"name": "orderId", "type": {"type": "string", "logicalType": "uuid"}, "doc": "Id of the order (message key)."},
    {"name": "orderNumber", "type": "string", "doc": "Human-readable order number."},
    {"name": "partnerId", "type": {"type": "string", "logicalType": "uuid"}, "doc": "Id of the delivery partner (= the partner's user id)."},
    {"name": "reason", "type": ["null", "string"], "default": null, "doc": "Free-text reason given by the admin; null if none."},
    {"name": "actorUserId", "type": ["null", {"type": "string", "logicalType": "uuid"}], "default": null, "doc": "The admin who reassigned."},
    {"name": "unassignedAt", "type": {"type": "long", "logicalType": "timestamp-micros"}, "doc": "When the partner was unassigned (UTC)."}
  ]
}
