{
  "type": "record",
  "name": "DeliveryOfferCreated",
  "namespace": "com.grocery.events.delivery",
  "doc": "A delivery was offered to a partner, who must accept before expiresAt; several partners may hold offers for the same delivery and the first to accept wins. Producer: delivery-service, topic delivery.events, key orderId (outbox aggregate type Delivery).",
  "fields": [
    {"name": "deliveryId", "type": {"type": "string", "logicalType": "uuid"}, "doc": "Id of the delivery."},
    {"name": "orderId", "type": {"type": "string", "logicalType": "uuid"}, "doc": "Id of the order (message key)."},
    {"name": "orderNumber", "type": "string", "doc": "Human-readable order number."},
    {"name": "offerId", "type": {"type": "string", "logicalType": "uuid"}, "doc": "Id of the offer."},
    {"name": "partnerId", "type": {"type": "string", "logicalType": "uuid"}, "doc": "Id of the delivery partner (= the partner's user id)."},
    {"name": "storeName", "type": ["null", "string"], "default": null, "doc": "Name of the store to pick up from; null if unknown."},
    {"name": "distanceKm", "type": "double", "doc": "Straight-line distance from the partner to the store when offered, km."},
    {"name": "tripKm", "type": ["null", "double"], "default": null, "doc": "Straight-line distance from the store to the customer, km."},
    {"name": "expiresAt", "type": {"type": "long", "logicalType": "timestamp-micros"}, "doc": "When the offer expires (UTC)."}
  ]
}
