{
  "type": "record",
  "name": "RestaurantOrderPreparing",
  "namespace": "com.grocery.events.restaurant",
  "doc": "The restaurant started preparing the order. Producer: restaurant-service, topic restaurant.events, key orderId (outbox aggregate type RestaurantOrder).",
  "fields": [
    {"name": "orderId", "type": {"type": "string", "logicalType": "uuid"}, "doc": "Id of the order (message key)."},
    {"name": "orderNumber", "type": "string", "doc": "Human-readable order number."},
    {"name": "restaurantId", "type": {"type": "string", "logicalType": "uuid"}, "doc": "Id of the restaurant that received the order."},
    {"name": "preparingAt", "type": {"type": "long", "logicalType": "timestamp-micros"}, "doc": "When preparing started (UTC)."},
    {"name": "actorUserId", "type": ["null", {"type": "string", "logicalType": "uuid"}], "default": null, "doc": "User id of the restaurant user."}
  ]
}
