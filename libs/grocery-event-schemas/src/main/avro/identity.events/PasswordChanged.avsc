{
  "type": "record",
  "name": "PasswordChanged",
  "namespace": "com.grocery.events.identity",
  "doc": "The password of an account was changed, by its owner while signed in or with a reset link. Producer: identity-service, topic identity.events, key userId. The account's other sessions were signed out. notification-service emails a security notice.",
  "fields": [
    {"name": "userId", "type": {"type": "string", "logicalType": "uuid"}, "doc": "Id of the account."},
    {"name": "email", "type": "string", "doc": "Login e-mail address of the account: the notice is sent there."},
    {"name": "fullName", "type": "string", "doc": "The account holder's name, for the greeting."},
    {"name": "method", "type": "string", "doc": "How the password was changed. One of: CHANGE, RESET."},
    {"name": "changedAt", "type": {"type": "long", "logicalType": "timestamp-micros"}, "doc": "When the new password was saved (UTC)."}
  ]
}
