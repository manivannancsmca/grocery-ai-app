{
  "type": "record",
  "name": "RefundFailed",
  "namespace": "com.grocery.events.payment",
  "doc": "A refund failed for good (not a temporary provider outage). Producer: payment-service, topic payment.events, key orderId. Consumer: order-service.",
  "fields": [
    {
      "name": "orderId",
      "type": {
        "type": "string",
        "logicalType": "uuid"
      },
      "doc": "Id of the order (message key)."
    },
    {
      "name": "paymentId",
      "type": {
        "type": "string",
        "logicalType": "uuid"
      },
      "doc": "Id of the payment."
    },
    {
      "name": "refundId",
      "type": {
        "type": "string",
        "logicalType": "uuid"
      },
      "doc": "Id of the failed refund."
    },
    {
      "name": "amount",
      "type": {
        "type": "bytes",
        "logicalType": "decimal",
        "precision": 12,
        "scale": 2
      },
      "doc": "Amount of the failed refund, 2 decimals."
    },
    {
      "name": "reason",
      "type": "string",
      "doc": "Refund reason. One of: ORDER_CANCELLED, LATE_CAPTURE, ADMIN."
    },
    {
      "name": "errorCode",
      "type": [
        "null",
        "string"
      ],
      "default": null,
      "doc": "Provider failure code; null if not reported."
    },
    {
      "name": "returnId",
      "type": [
        "null",
        {
          "type": "string",
          "logicalType": "uuid"
        }
      ],
      "default": null,
      "doc": "The return this refund is for (reason RETURN, Phase 12); null for other refunds."
    }
  ]
}
