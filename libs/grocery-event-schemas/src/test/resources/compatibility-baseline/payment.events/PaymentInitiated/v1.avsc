{
  "type": "record",
  "name": "PaymentInitiated",
  "namespace": "com.grocery.events.payment",
  "doc": "The Razorpay order exists; the customer can pay until expiresAt (payment CREATED -> PENDING). Producer: payment-service, topic payment.events, key orderId. Consumer: order-service.",
  "fields": [
    {"name": "orderId", "type": {"type": "string", "logicalType": "uuid"}, "doc": "Id of the order (message key)."},
    {"name": "paymentId", "type": {"type": "string", "logicalType": "uuid"}, "doc": "Id of the payment."},
    {"name": "razorpayOrderId", "type": ["null", "string"], "default": null, "doc": "Razorpay order id returned by the provider (order_...); null only if the provider response lacked it."},
    {"name": "amount", "type": {"type": "bytes", "logicalType": "decimal", "precision": 12, "scale": 2}, "doc": "Amount to pay, 2 decimals."},
    {"name": "currency", "type": "string", "doc": "ISO 4217 currency code, always INR today."},
    {"name": "expiresAt", "type": {"type": "long", "logicalType": "timestamp-micros"}, "doc": "End of the payment window (UTC)."}
  ]
}
