{
  "type": "record",
  "name": "RestaurantOrderRejected",
  "namespace": "com.grocery.events.restaurant",
  "doc": "The restaurant rejected the order, or it was auto-rejected because nobody accepted it before acceptBy; order-service cancels it and the customer is refunded. Producer: restaurant-service, topic restaurant.events, key orderId (outbox aggregate type RestaurantOrder).",
  "fields": [
    {"name": "orderId", "type": {"type": "string", "logicalType": "uuid"}, "doc": "Id of the order (message key)."},
    {"name": "orderNumber", "type": "string", "doc": "Human-readable order number."},
    {"name": "restaurantId", "type": {"type": "string", "logicalType": "uuid"}, "doc": "Id of the restaurant that received the order."},
    {"name": "reason", "type": "string", "doc": "Rejection reason. One of: OUT_OF_STOCK, STORE_CLOSED, TOO_BUSY, OTHER, NO_RESPONSE (automatic)."},
    {"name": "note", "type": ["null", "string"], "default": null, "doc": "Free-text explanation from the restaurant; null if none."},
    {"name": "auto", "type": "boolean", "doc": "True when the order was rejected automatically at the acceptance deadline."},
    {"name": "rejectedAt", "type": {"type": "long", "logicalType": "timestamp-micros"}, "doc": "When the order was rejected (UTC)."},
    {"name": "actorUserId", "type": ["null", {"type": "string", "logicalType": "uuid"}], "default": null, "doc": "User id of the restaurant user who rejected; null for an automatic rejection."}
  ]
}
