{
  "type": "record",
  "name": "VendorOrderReadyForPickup",
  "namespace": "com.grocery.events.vendor",
  "doc": "The order is ready for a delivery partner to pick up. Producer: vendor-service, topic vendor.events, key orderId (outbox aggregate type VendorOrder).",
  "fields": [
    {"name": "orderId", "type": {"type": "string", "logicalType": "uuid"}, "doc": "Id of the order (message key)."},
    {"name": "orderNumber", "type": "string", "doc": "Human-readable order number."},
    {"name": "vendorId", "type": {"type": "string", "logicalType": "uuid"}, "doc": "Id of the vendor that received the order."},
    {"name": "readyAt", "type": {"type": "long", "logicalType": "timestamp-micros"}, "doc": "When the order became ready (UTC)."},
    {"name": "actorUserId", "type": ["null", {"type": "string", "logicalType": "uuid"}], "default": null, "doc": "User id of the vendor user."}
  ]
}
