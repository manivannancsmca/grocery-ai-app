#!/bin/sh
# Sourced by the base image's /docker-entrypoint.sh after 15-local-resolvers.envsh and before the templates are
# rendered (20-envsubst-on-templates.sh). Validates API_UPSTREAM and makes sure the /api proxy has a DNS resolver.
# A bad value stops the container at once instead of serving a broken /api.

grocery_upstream="${API_UPSTREAM:-http://api-gateway:8080}"
grocery_upstream="${grocery_upstream%/}"

case "$grocery_upstream" in
  http://?*|https://?*) ;;
  *)
    echo "16-grocery-api-upstream.envsh: ERROR: API_UPSTREAM must be http(s)://host[:port], got '${API_UPSTREAM:-}'" >&2
    exit 1
    ;;
esac
case "${grocery_upstream#*://}" in
  */*|*\ *|*\"*|*\;*)
    # A path would replace the request URI (proxy_pass with a variable), and quotes/semicolons would break the config.
    echo "16-grocery-api-upstream.envsh: ERROR: API_UPSTREAM must not contain a path, spaces, quotes or ';', got '${API_UPSTREAM:-}'" >&2
    exit 1
    ;;
esac
export API_UPSTREAM="$grocery_upstream"

# No nameserver in /etc/resolv.conf (unusual): fall back to Docker's embedded DNS.
if [ -z "${NGINX_LOCAL_RESOLVERS:-}" ]; then
  export NGINX_LOCAL_RESOLVERS=127.0.0.11
fi

echo "16-grocery-api-upstream.envsh: /api/ -> $API_UPSTREAM (resolver $NGINX_LOCAL_RESOLVERS)"
unset grocery_upstream
